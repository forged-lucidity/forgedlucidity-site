{
    "framework":  null,
    "buildCommand":  "",
    "outputDirectory":  "public",
    "cleanUrls":  true,
    "trailingSlash":  false,
    "headers":  [
                    {
                        "source":  "/downloads/(.*)",
                        "headers":  [
                                        {
                                            "key":  "Content-Disposition",
                                            "value":  "attachment"
                                        }
                                    ]
                    },
                    {
                        "source":  "/(.*)",
                        "headers":  [
                                        {
                                            "key":  "X-Content-Type-Options",
                                            "value":  "nosniff"
                                        },
                                        {
                                            "key":  "X-Frame-Options",
                                            "value":  "DENY"
                                        },
                                        {
                                            "key":  "Referrer-Policy",
                                            "value":  "strict-origin-when-cross-origin"
                                        }
                                    ]
                    }
                ],
    "rewrites":  [
                     {
                         "destination":  "/research/index.html",
                         "source":  "/research"
                     },
                     {
                         "destination":  "/businesses/braunlaw.us/index.html",
                         "source":  "/businesses/braunlaw.us"
                     },
                     {
                         "destination":  "/businesses/braunlaw.us/ai.html",
                         "source":  "/businesses/braunlaw.us/ai"
                     }
                 ],
    "redirects":  [
                      {
                          "destination":  "/businesses/braunlaw.us",
                          "permanent":  true,
                          "source":  "/businesses/braun-law"
                      },
                      {
                          "destination":  "/businesses/braunlaw.us/ai",
                          "permanent":  true,
                          "source":  "/businesses/braun-law/ai"
                      }
                  ]
}
